DATABASE_URL="file:./prisma/dev.db"
# Required for libsql:// (Turso) URLs; leave unset for local file: databases.
# On Vercel the Turso integration provides DATABASE_TURSO_DATABASE_URL and DATABASE_TURSO_AUTH_TOKEN instead.
# TURSO_AUTH_TOKEN=""
# Optional passkey overrides. On Vercel they are derived from the deployment URL.
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_ORIGIN="http://localhost:3000"
# create a new file called .env and copy the contents of .env.example
